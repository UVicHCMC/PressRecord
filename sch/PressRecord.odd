            <elementSpec ident="transaction" module="PressRecord">
               <gloss>Transaction</gloss>
               <desc>Purchases and forms of monetization that appear in, or are indexed by, the gameplay footage</desc>
               <desc>Select “No transaction” if the footage contains no observable purchase or form of monetization.</desc>
