   <define name="gameplayRecord">
      <element name="gameplayRecord">
         <a:documentation xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0">(Record of a single gameplay recording) This is the root element for a record in the schema.</a:documentation>
         <group>
            <ref name="platformEdition"/>
            <text/>
         </group>
         <ref name="att.identifiable.attributes"/>
         <empty/>
      </element>
   </define>
   <define name="platformEdition">
      <element name="platformEdition">
         <a:documentation xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0">(Platform Edition Entity) Denotes a particular instantiation of a video game. An edition may be a particular release of a game that is in some way different than another release of the same game (Lee et al., VGMS 4.2, 2024)</a:documentation>
         <group>
            <ref name="title"/>
            <ref name="release"/>
         </group>
      </element>
   </define>
   <define name="title">
      <element name="title">
         <a:documentation xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0">(Title) The title of whatever item forms the parent of the element.</a:documentation>
         <text/>
      </element>
   </define>
   <define name="release">
      <element name="release">
         <a:documentation xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0">(Release) The release includes the year and release type.</a:documentation>
         <empty/>
         <attribute name="year">
            <a:documentation xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0">(The year of release of this game edition) </a:documentation>
            <data type="gYear"/>
         </attribute>
         <attribute name="type">
            <a:documentation xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0">(Type of release) </a:documentation>
            <choice>
               <value>rtAlpha</value>
               <a:documentation xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0">(Alpha) </a:documentation>
               <value>rtBeta</value>
               <a:documentation xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0">(Beta) </a:documentation>
               <value>rtDemo</value>
               <a:documentation xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0">(Demo) </a:documentation>
               <value>rtDownloadable</value>
               <a:documentation xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0">(Downloadable content (DLC)) </a:documentation>
               <value>rtEarlyAccess</value>
               <a:documentation xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0">(Early access) </a:documentation>
               <value>rtEmulation</value>
               <a:documentation xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0">(Emulation) </a:documentation>
               <value>rtExpansion</value>
               <a:documentation xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0">(Expansion) </a:documentation>
               <value>rtFanGame</value>
               <a:documentation xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0">(Fan game) </a:documentation>
               <value>rtInitOrOrigRelease</value>
               <a:documentation xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0">(Initial release / original release) </a:documentation>
               <value>rtPort</value>
               <a:documentation xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0">(Port) </a:documentation>
               <value>rtReboot</value>
               <a:documentation xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0">(Reboot) </a:documentation>
               <value>rtRemake</value>
               <a:documentation xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0">(Remake) </a:documentation>
               <value>rtRemaster</value>
               <a:documentation xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0">(Remaster) </a:documentation>
               <value>rtUnfinished</value>
               <a:documentation xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0">(Unfinished) </a:documentation>
            </choice>
         </attribute>
         <empty/>
      </element>
   </define>
   <define name="att.identifiable.attributes">
      <ref name="att.identifiable.attribute.xmlid"/>
   </define>
   <define name="att.identifiable.attribute.xmlid">
      <attribute name="xml:id">
         <a:documentation xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0">(standard xml:id attribute) </a:documentation>
         <data type="ID"/>
      </attribute>
   </define>
   <start>
      <choice>
         <ref name="gameplayRecord"/>
      </choice>
   </start>
   <sch:ns xmlns="http://www.tei-c.org/ns/1.0"
           xmlns:pr="http://hcmc.uvic.ca/ns/PressRecord"
           xmlns:rng="http://relaxng.org/ns/structure/1.0"
           xmlns:sch="http://purl.oclc.org/dsdl/schematron"
           xmlns:sqf="http://www.schematron-quickfix.com/validator/process"
           xmlns:xsl="http://www.w3.org/1999/XSL/Transform"
           prefix="tei"
           uri="http://www.tei-c.org/ns/1.0"/>
   <sch:ns xmlns="http://www.tei-c.org/ns/1.0"
           xmlns:pr="http://hcmc.uvic.ca/ns/PressRecord"
           xmlns:rng="http://relaxng.org/ns/structure/1.0"
           xmlns:sch="http://purl.oclc.org/dsdl/schematron"
           xmlns:sqf="http://www.schematron-quickfix.com/validator/process"
           xmlns:xsl="http://www.w3.org/1999/XSL/Transform"
           prefix="xs"
           uri="http://www.w3.org/2001/XMLSchema"/>
   <sch:ns xmlns="http://www.tei-c.org/ns/1.0"
           xmlns:pr="http://hcmc.uvic.ca/ns/PressRecord"
           xmlns:rng="http://relaxng.org/ns/structure/1.0"
           xmlns:sch="http://purl.oclc.org/dsdl/schematron"
           xmlns:sqf="http://www.schematron-quickfix.com/validator/process"
           xmlns:xsl="http://www.w3.org/1999/XSL/Transform"
           prefix="rng"
           uri="http://relaxng.org/ns/structure/1.0"/>
   <sch:ns xmlns="http://www.tei-c.org/ns/1.0"
           xmlns:pr="http://hcmc.uvic.ca/ns/PressRecord"
           xmlns:rng="http://relaxng.org/ns/structure/1.0"
           xmlns:sch="http://purl.oclc.org/dsdl/schematron"
           xmlns:sqf="http://www.schematron-quickfix.com/validator/process"
           xmlns:xsl="http://www.w3.org/1999/XSL/Transform"
           prefix="rna"
           uri="http://relaxng.org/ns/compatibility/annotations/1.0"/>
   <sch:ns xmlns="http://www.tei-c.org/ns/1.0"
           xmlns:pr="http://hcmc.uvic.ca/ns/PressRecord"
           xmlns:rng="http://relaxng.org/ns/structure/1.0"
           xmlns:sch="http://purl.oclc.org/dsdl/schematron"
           xmlns:sqf="http://www.schematron-quickfix.com/validator/process"
           xmlns:xsl="http://www.w3.org/1999/XSL/Transform"
           prefix="sch"
           uri="http://purl.oclc.org/dsdl/schematron"/>
   <sch:ns xmlns="http://www.tei-c.org/ns/1.0"
           xmlns:pr="http://hcmc.uvic.ca/ns/PressRecord"
           xmlns:rng="http://relaxng.org/ns/structure/1.0"
           xmlns:sch="http://purl.oclc.org/dsdl/schematron"
           xmlns:sqf="http://www.schematron-quickfix.com/validator/process"
           xmlns:xsl="http://www.w3.org/1999/XSL/Transform"
           prefix="sch1x"
           uri="http://www.ascc.net/xml/schematron"/>
   <sch:pattern xmlns="http://www.tei-c.org/ns/1.0"
                xmlns:pr="http://hcmc.uvic.ca/ns/PressRecord"
                xmlns:sch="http://purl.oclc.org/dsdl/schematron"
                xmlns:sqf="http://www.schematron-quickfix.com/validator/process"
                xmlns:xsl="http://www.w3.org/1999/XSL/Transform">
      <sch:let name="spaceRegex" value="'(^\s)|(\s$)'"/>
      <sch:let name="docId" value="root(/)/pr:*/@xml:id"/>
      <sch:let name="docUri" value="document-uri(/)"/>
      <sch:let name="docIds" value="//pr:*[@xml:id]/@xml:id"/>
   </sch:pattern>
   <sch:pattern xmlns="http://www.tei-c.org/ns/1.0"
                xmlns:pr="http://hcmc.uvic.ca/ns/PressRecord"
                xmlns:sch="http://purl.oclc.org/dsdl/schematron"
                xmlns:sqf="http://www.schematron-quickfix.com/validator/process"
                xmlns:xsl="http://www.w3.org/1999/XSL/Transform">
      <sch:rule context="/pr:*">
         <sch:assert test="@xml:id and matches($docUri,concat('[/\\]',$docId,'.xml$'))"> ERROR: Document
                           xml:id (<sch:value-of select="$docId"/>) does not match the document file
                           name (<sch:value-of select="$docUri"/>). </sch:assert>
      </sch:rule>
   </sch:pattern>
</grammar>
