         <oneOrMore>
            <ref name="theme"/>
         </oneOrMore>
      </element>
   </define>
   <define name="assets">
      <element name="assets">
         <a:documentation xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0">(Assets) Groups the assets metadata fields.</a:documentation>
         <oneOrMore>
            <ref name="asset"/>
         </oneOrMore>
      </element>
   </define>
   <define name="styles">
      <element name="styles">
         <a:documentation xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0">(Styles) Groups the styles metadata fields.</a:documentation>
         <oneOrMore>
            <ref name="style"/>
         </oneOrMore>
      </element>
   </define>
   <define name="interfaces">
      <element name="interfaces">
         <a:documentation xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0">(Interfaces) Groups the interfaces metadata fields.</a:documentation>
         <oneOrMore>
            <ref name="interface"/>
         </oneOrMore>
      </element>
   </define>
   <define name="experiences">
      <element name="experiences">
         <a:documentation xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0">(Experiences) Groups the experiences metadata fields.</a:documentation>
         <oneOrMore>
            <ref name="experience"/>
         </oneOrMore>
      </element>
   </define>
   <define name="transactions">
      <element name="transactions">
         <a:documentation xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0">(Transactions) Groups the transactions metadata fields.</a:documentation>
         <oneOrMore>
            <ref name="transaction"/>
         </oneOrMore>
      </element>
   </define>
   <define name="metagamingTypes">
      <element name="metagamingTypes">
         <a:documentation xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0">(Metagaming types) Groups the metagaming types metadata fields.</a:documentation>
         <oneOrMore>
            <ref name="metagamingType"/>
         </oneOrMore>
      </element>
   </define>
   <define name="tropes">
      <element name="tropes">
         <a:documentation xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0">(Tropes) Groups the tropes metadata fields.</a:documentation>
         <group>
            <zeroOrMore>
               <ref name="gameplayTrope"/>
            </zeroOrMore>
            <zeroOrMore>
               <ref name="environmentTrope"/>
            </zeroOrMore>
            <zeroOrMore>
               <ref name="progressionTrope"/>
            </zeroOrMore>
            <zeroOrMore>
               <ref name="narrativeTrope"/>
            </zeroOrMore>
            <optional>
               <ref name="characterTrope"/>
            </optional>
         </group>
      </element>
   </define>
   <define name="gameStudiesTopics">
      <element name="gameStudiesTopics">
         <a:documentation xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0">(Game studies topics) Groups the game studies topics metadata fields.</a:documentation>
         <oneOrMore>
            <ref name="gameStudiesTopic"/>
         </oneOrMore>
      </element>
   </define>
   <define name="mediaStudiesTopics">
      <element name="mediaStudiesTopics">
         <a:documentation xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0">(Media studies topics) Groups the media studies topics metadata fields.</a:documentation>
         <oneOrMore>
            <ref name="mediaStudiesTopic"/>
         </oneOrMore>
      </element>
   </define>
   <define name="release">
      <element name="release">
         <a:documentation xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0">(Release) The edition's release year and one or more release types.</a:documentation>
         <empty/>
         <attribute name="type">
            <a:documentation xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0">(Release Type) The platform edition’s release type as assigned by its developer, publisher, and/or distributor Encoders will use existing scholarship, MobyGames, Wikipedia, Steam, and/or fansites to confirm the release type if it was not assigned by the developer, publisher, and/or distributor.Use one or more whitespace-separated taxonomy IDs.</a:documentation>
            <list>
               <oneOrMore>
                  <choice>
                     <value>rtAlpha</value>
                     <a:documentation xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0">(Alpha) </a:documentation>
                     <value>rtBeta</value>
                     <a:documentation xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0">(Beta) </a:documentation>
                     <value>rtDemo</value>
                     <a:documentation xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0">(Demo) </a:documentation>
                     <value>rtDownloadable</value>
                     <a:documentation xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0">(Downloadable content (DLC)) </a:documentation>
                     <value>rtEarlyAccess</value>
                     <a:documentation xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0">(Early access) </a:documentation>
                     <value>rtEmulation</value>
                     <a:documentation xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0">(Emulation) </a:documentation>
                     <value>rtExpansion</value>
                     <a:documentation xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0">(Expansion) </a:documentation>
                     <value>rtFanGame</value>
                     <a:documentation xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0">(Fan game) </a:documentation>
                     <value>rtInitOrOrigRelease</value>
                     <a:documentation xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0">(Initial release / original release) </a:documentation>
                     <value>rtPort</value>
                     <a:documentation xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0">(Port) </a:documentation>
                     <value>rtReboot</value>
                     <a:documentation xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0">(Reboot) </a:documentation>
                     <value>rtRemake</value>
                     <a:documentation xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0">(Remake) </a:documentation>
                     <value>rtRemaster</value>
                     <a:documentation xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0">(Remaster) </a:documentation>
                     <value>rtUnfinished</value>
                     <a:documentation xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0">(Unfinished) </a:documentation>
                  </choice>
               </oneOrMore>
            </list>
         </attribute>
         <attribute name="year">
            <a:documentation xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0">The year of release of this game edition.</a:documentation>
            <data type="gYear"/>
         </attribute>
         <empty/>
      </element>
   </define>
   <define name="publisher">
      <element name="publisher">
         <a:documentation xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0">(Publisher) The publisher name as free text, classified by Publisher Class in @type.</a:documentation>
         <text/>
         <attribute name="type">
            <a:documentation xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0">(Publisher Class) The size, profile, and/or budget of the publisher and, in some cases, the developer, tooThis element rarely needs to be repeated. Exceptions include cases where the platform edition is both indie and self-published.Use existing scholarship, MobyGames, Wikipedia, Steam, and/or fansites to confirm the publisher class.</a:documentation>
            <choice>
               <value>pclAA</value>
               <a:documentation xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0">(AA) </a:documentation>
