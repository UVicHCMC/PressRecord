   <define name="narrativeGenre">
      <element name="narrativeGenre">
         <a:documentation xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0">(Narrative Genre) The overall nature of storytelling in the gameplay footage based on how the platform edition tells, plots, and arranges storiesUse abstract / no narrative for abstract games and games without narratives or narrative elements.</a:documentation>
         <choice>
            <value>Abstract / no narrative</value>
            <a:documentation xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0"/>
            <value>Action</value>
            <a:documentation xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0"/>
            <value>Adventure</value>
            <a:documentation xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0"/>
