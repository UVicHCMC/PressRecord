   <define name="mediaStudiesTopic">
      <element name="mediaStudiesTopic">
         <a:documentation xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0">(Media Studies Topic) Area of Media Studies research, analysis, and discussion prompted by the gameplay footageThis controlled vocabulary corresponds with primary topics taught in MDIA200, Media in the 21st Century, at UVic.</a:documentation>
         <choice>
            <value>Acts and senses of communication</value>
            <a:documentation xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0"/>
