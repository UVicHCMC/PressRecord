      <ref name="model.placeStateLike_sequence"/>
   </define>
   <define name="model.nameLike_sequenceOptional">
      <optional>
         <ref name="model.nameLike.agent_sequenceOptional"/>
      </optional>
      <optional>
         <ref name="model.offsetLike_sequenceOptional"/>
      </optional>
      <optional>
         <ref name="model.placeStateLike_sequenceOptional"/>
      </optional>
   </define>
   <define name="model.nameLike_sequenceOptionalRepeatable">
      <zeroOrMore>
         <ref name="model.nameLike.agent_sequenceOptionalRepeatable"/>
      </zeroOrMore>
      <zeroOrMore>
         <ref name="model.offsetLike_sequenceOptionalRepeatable"/>
      </zeroOrMore>
      <zeroOrMore>
         <ref name="model.placeStateLike_sequenceOptionalRepeatable"/>
      </zeroOrMore>
   </define>
   <define name="model.nameLike_sequenceRepeatable">
      <oneOrMore>
         <ref name="model.nameLike.agent_sequenceRepeatable"/>
      </oneOrMore>
      <oneOrMore>
         <ref name="model.offsetLike_sequenceRepeatable"/>
      </oneOrMore>
      <oneOrMore>
         <ref name="model.placeStateLike_sequenceRepeatable"/>
      </oneOrMore>
   </define>
   <define name="model.pPart.data">
      <choice>
         <ref name="model.dateLike"/>
         <ref name="model.measureLike"/>
         <ref name="model.addressLike"/>
         <ref name="model.nameLike"/>
      </choice>
   </define>
   <define name="model.pPart.data_alternation">
      <choice>
         <ref name="model.dateLike_alternation"/>
         <ref name="model.measureLike_alternation"/>
         <ref name="model.addressLike_alternation"/>
         <ref name="model.nameLike_alternation"/>
      </choice>
   </define>
   <define name="model.pPart.data_sequence">
      <ref name="model.dateLike_sequence"/>
      <ref name="model.measureLike_sequence"/>
      <ref name="model.addressLike_sequence"/>
      <ref name="model.nameLike_sequence"/>
   </define>
   <define name="model.pPart.data_sequenceOptional">
      <optional>
         <ref name="model.dateLike_sequenceOptional"/>
      </optional>
      <optional>
         <ref name="model.measureLike_sequenceOptional"/>
      </optional>
      <optional>
         <ref name="model.addressLike_sequenceOptional"/>
      </optional>
      <optional>
         <ref name="model.nameLike_sequenceOptional"/>
      </optional>
   </define>
   <define name="model.pPart.data_sequenceOptionalRepeatable">
      <zeroOrMore>
         <ref name="model.dateLike_sequenceOptionalRepeatable"/>
      </zeroOrMore>
      <zeroOrMore>
         <ref name="model.measureLike_sequenceOptionalRepeatable"/>
      </zeroOrMore>
      <zeroOrMore>
         <ref name="model.addressLike_sequenceOptionalRepeatable"/>
      </zeroOrMore>
      <zeroOrMore>
         <ref name="model.nameLike_sequenceOptionalRepeatable"/>
      </zeroOrMore>
   </define>
   <define name="model.pPart.data_sequenceRepeatable">
      <oneOrMore>
         <ref name="model.dateLike_sequenceRepeatable"/>
      </oneOrMore>
      <oneOrMore>
         <ref name="model.measureLike_sequenceRepeatable"/>
      </oneOrMore>
      <oneOrMore>
         <ref name="model.addressLike_sequenceRepeatable"/>
      </oneOrMore>
      <oneOrMore>
         <ref name="model.nameLike_sequenceRepeatable"/>
      </oneOrMore>
   </define>
   <define name="platform">
      <element name="platform">
         <a:documentation xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0">(Platform) The operating system, device, computer, console, and/or service on which the platform edition was played and recorded (Lee et al., VGMS 4.2, 2024)</a:documentation>
         <rng:empty xmlns:rng="http://relaxng.org/ns/structure/1.0"/>
      </element>
   </define>
   <define name="engine">
      <element name="engine">
         <a:documentation xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0">(Engine) The software framework and/or development environment used to design the platform edition</a:documentation>
         <rng:empty xmlns:rng="http://relaxng.org/ns/structure/1.0"/>
      </element>
   </define>
   <define name="developerLocation">
      <element name="developerLocation">
         <a:documentation xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0">(Developer’s Location) The geographic location of the platform edition’s developer(s)</a:documentation>
         <choice>
            <ref name="countryCodes"/>
            <ref name="developerLocationAdditionalCodes"/>
         </choice>
      </element>
   </define>
   <define name="publisher">
      <element name="publisher">
         <a:documentation xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0">(Publisher) The publisher name as free text, classified by the Publisher Class vocabulary in @type.</a:documentation>
         <text/>
         <attribute name="type">
            <a:documentation xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0">(Publisher class) </a:documentation>
            <choice>
               <value>pclAA</value>
               <a:documentation xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0">(AA) </a:documentation>
               <value>pclAAA</value>
               <a:documentation xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0">(AAA) </a:documentation>
               <value>pclB</value>
               <a:documentation xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0">(B) </a:documentation>
               <value>pclIII</value>
               <a:documentation xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0">(III) </a:documentation>
               <value>pclIndie</value>
               <a:documentation xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0">(Indie) </a:documentation>
               <value>pclLicensed_game</value>
               <a:documentation xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0">(Licensed game) </a:documentation>
               <value>pclSelf-published</value>
               <a:documentation xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0">(Self-published) </a:documentation>
            </choice>
         </attribute>
         <empty/>
      </element>
   </define>
   <define name="commentary">
      <element name="commentary">
         <a:documentation xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0">(Commentary) The type of player commentary, if any, included in the gameplay footage of the platform edition</a:documentation>
         <rng:empty xmlns:rng="http://relaxng.org/ns/structure/1.0"/>
      </element>
   </define>
   <define name="chat">
      <element name="chat">
         <a:documentation xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0">(Chat) The type of chat, if any, included in the gameplay footage of the platform edition</a:documentation>
         <rng:empty xmlns:rng="http://relaxng.org/ns/structure/1.0"/>
      </element>
   </define>
   <define name="recordStatus">
      <element name="recordStatus">
         <a:documentation xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0">(Metadata Record Status) Communicates whether the metadata record for the gampeplay file is complete</a:documentation>
         <rng:empty xmlns:rng="http://relaxng.org/ns/structure/1.0"/>
      </element>
   </define>
   <define name="inputDevice">
      <element name="inputDevice">
         <a:documentation xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0">(Input Device) The equipment used to play the platform edition while the video was recorded (Lee et al., VGMS 4.2, 2024)</a:documentation>
         <rng:empty xmlns:rng="http://relaxng.org/ns/structure/1.0"/>
      </element>
   </define>
   <define name="connectivity">
      <element name="connectivity">
         <a:documentation xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0">(Connectivity) The number of players in the gameplay footage of the platform edition (Lee et al., VGMS 4.2, 2024)</a:documentation>
         <rng:empty xmlns:rng="http://relaxng.org/ns/structure/1.0"/>
      </element>
   </define>
   <define name="numPlayers">
      <element name="numPlayers">
         <a:documentation xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0">(Number of Players) The number of players in the gameplay footage of the platform edition (Lee et al., VGMS 4.2, 2024)</a:documentation>
         <rng:empty xmlns:rng="http://relaxng.org/ns/structure/1.0"/>
      </element>
   </define>
   <define name="gameplayMode">
      <element name="gameplayMode">
         <a:documentation xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0">(Gameplay Mode) A distinct configuration of the platform edition’s mechanics and gameplay in the gameplay footage</a:documentation>
         <rng:empty xmlns:rng="http://relaxng.org/ns/structure/1.0"/>
      </element>
   </define>
   <define name="accessibility">
      <element name="accessibility">
         <a:documentation xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0">(Accessibility) A configuration or appearance of the platform edition’s accessibility features in the gameplay footage</a:documentation>
         <rng:empty xmlns:rng="http://relaxng.org/ns/structure/1.0"/>
      </element>
   </define>
   <define name="typeOfPlay">
      <element name="typeOfPlay">
         <a:documentation xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0">(Type of Play) How players relate socially to each other and the game in the gameplay footage</a:documentation>
         <rng:empty xmlns:rng="http://relaxng.org/ns/structure/1.0"/>
      </element>
   </define>
   <define name="gameplayGenre">
      <element name="gameplayGenre">
         <a:documentation xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0">(Gameplay Genre) The overall nature of . . . interactivity in the gameplay footage based on [the platform edition’s] objectives, types of rules, distinctive characteristics, modes of action, and manners of gameplay (Lee et al., VGMS 4.2, 2024)</a:documentation>
         <rng:empty xmlns:rng="http://relaxng.org/ns/structure/1.0"/>
      </element>
   </define>
   <define name="gameplaySubgenre">
      <element name="gameplaySubgenre">
         <a:documentation xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0">(Gameplay Subgenre) Patterns of interactivity appearing in the gameplay footage based on [the platform edition’s] objectives, types of rules, distinctive characteristics, modes of action, and manners of gameplay (Lee et al., VGMS 4.2, 2024)</a:documentation>
         <rng:empty xmlns:rng="http://relaxng.org/ns/structure/1.0"/>
      </element>
   </define>
   <define name="narrativeGenre">
      <element name="narrativeGenre">
         <a:documentation xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0">(Narrative Genre) The overall nature of storytelling in the gameplay footage based on how the platform edition tells, plots, and arranges stories</a:documentation>
         <rng:empty xmlns:rng="http://relaxng.org/ns/structure/1.0"/>
      </element>
   </define>
   <define name="narrativeSubgenre">
      <element name="narrativeSubgenre">
         <a:documentation xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0">(Narrative Subgenre) Patterns of storytelling in the gameplay footage based on how the platform edition tells, plots, and arranges stories</a:documentation>
         <rng:empty xmlns:rng="http://relaxng.org/ns/structure/1.0"/>
      </element>
   </define>
   <define name="dimensionPerspective">
      <element name="dimensionPerspective">
         <a:documentation xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0">(Dimension and Perspective) The intended perception of the depth of the represented entities in the gameplay footage and [t]he [graphical projection, camera, and/or point of view] from which the player experiences the gameplay (Lee et al., VGMS 4.2, 2024)</a:documentation>
         <rng:empty xmlns:rng="http://relaxng.org/ns/structure/1.0"/>
      </element>
   </define>
   <define name="location">
      <element name="location">
         <a:documentation xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0">(Location) The planet, continent, and/or country appearing the gameplay footage</a:documentation>
         <choice>
            <ref name="countryCodes"/>
            <ref name="locationAdditionalCodes"/>
         </choice>
      </element>
   </define>
   <define name="timePeriod">
      <element name="timePeriod">
         <a:documentation xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0">(Time Period) The general time period in which the gameplay footage is set</a:documentation>
         <rng:empty xmlns:rng="http://relaxng.org/ns/structure/1.0"/>
      </element>
   </define>
   <define name="biome">
      <element name="biome">
         <a:documentation xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0">(Biome) The ecological community type appearing in the gameplay footage</a:documentation>
         <rng:empty xmlns:rng="http://relaxng.org/ns/structure/1.0"/>
      </element>
   </define>
   <define name="builtEnv">
      <element name="builtEnv">
         <a:documentation xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0">(Built Environment) An artificial physical feature or edifice appearing in the gameplay footage that’s typically meant to surround, structure, and/or guide the diegetic activities of characters in the platform edition</a:documentation>
         <rng:empty xmlns:rng="http://relaxng.org/ns/structure/1.0"/>
      </element>
   </define>
   <define name="transport">
      <element name="transport">
         <a:documentation xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0">(Means of Transport) A means of conveyance or travel from one place to another appearing in the gameplay footage</a:documentation>
         <rng:empty xmlns:rng="http://relaxng.org/ns/structure/1.0"/>
      </element>
   </define>
   <define name="items">
      <element name="items">
         <a:documentation xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0">(Items) Types of consumables, equipment, progression items, crafting materials, currencies, and valuables appearing in the gameplay footage (Wikipedia, Item (game terminology), 2026)</a:documentation>
         <rng:empty xmlns:rng="http://relaxng.org/ns/structure/1.0"/>
      </element>
   </define>
   <define name="atmosphere">
      <element name="atmosphere">
         <a:documentation xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0">(Atmosphere) The pervading [mood] or tone of the world appearing in the gameplay footage; it evokes or recalls a certain emotion or state of mind (Lee et al., VGMS 4.2, 2024)</a:documentation>
         <rng:empty xmlns:rng="http://relaxng.org/ns/structure/1.0"/>
      </element>
   </define>
   <define name="playerCharacter">
      <element name="playerCharacter">
         <a:documentation xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0">(Player Character) A character in the gameplay footage whose actions are controlled by the player</a:documentation>
         <rng:empty xmlns:rng="http://relaxng.org/ns/structure/1.0"/>
      </element>
   </define>
   <define name="nonPlayerCharacter">
      <element name="nonPlayerCharacter">
         <a:documentation xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0">(Non-Player Character) A character in the gameplay footage whose actions are not controlled by the player</a:documentation>
         <rng:empty xmlns:rng="http://relaxng.org/ns/structure/1.0"/>
      </element>
   </define>
   <define name="mechanics">
      <element name="mechanics">
         <a:documentation xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0">(Mechanics) A method or verb players use to interact with the state of the platform edition as it appears in the gameplay footage (Sicart 2015; Lee et al., VGMS 4.2, 2024)</a:documentation>
         <rng:empty xmlns:rng="http://relaxng.org/ns/structure/1.0"/>
      </element>
   </define>
   <define name="timekeeping">
      <element name="timekeeping">
         <a:documentation xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0">(Timekeeping) How the platform edition handles the passage of time in the gameplay footage; approaches to timekeeping inevitably influence narrative pacing as well as the timing and rhythm of both players and games</a:documentation>
         <rng:empty xmlns:rng="http://relaxng.org/ns/structure/1.0"/>
      </element>
   </define>
   <define name="progression">
      <element name="progression">
         <a:documentation xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0">(Progression) How, as demonstrated by the footage, the platform edition allows players to advance, acknowledges their attempts to advance, or affords them with a sense of progress, achievement, or productivity (Lee et al., VGMS 4.2, 2024)</a:documentation>
         <rng:empty xmlns:rng="http://relaxng.org/ns/structure/1.0"/>
      </element>
   </define>
   <define name="theme">
      <element name="theme">
         <a:documentation xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0">(Theme) A common thread, motif, subject, or idea that recurs in the gameplay footage (Getty 2004; Lee et al., VGMS 4.2, 2024)</a:documentation>
         <rng:empty xmlns:rng="http://relaxng.org/ns/structure/1.0"/>
      </element>
   </define>
   <define name="assets">
      <element name="assets">
         <a:documentation xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0">(Assets) Audio, visual, and functional elements, including individual pieces of content, appearing in the gameplay footage</a:documentation>
         <rng:empty xmlns:rng="http://relaxng.org/ns/structure/1.0"/>
      </element>
   </define>
   <define name="style">
      <element name="style">
         <a:documentation xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0">(Style) The predominant and recognizable [artistic tendencies] and appearance of the platform edition as demonstrated by the gameplay footage (Lee et al., VGMS 4.2, 2024)</a:documentation>
         <rng:empty xmlns:rng="http://relaxng.org/ns/structure/1.0"/>
      </element>
   </define>
   <define name="interface">
      <element name="interface">
         <a:documentation xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0">(Interface) The means by which players interact or communicate with the game and each other in the gameplay footage; also, how the game prompts and transforms input into output in the gameplay footage</a:documentation>
         <rng:empty xmlns:rng="http://relaxng.org/ns/structure/1.0"/>
      </element>
   </define>
   <define name="experience">
      <element name="experience">
         <a:documentation xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0">(Experience) An emotion, feeling, or range of emotions and feelings experienced by the player when the gameplay footage was recorded</a:documentation>
         <rng:empty xmlns:rng="http://relaxng.org/ns/structure/1.0"/>
      </element>
   </define>
   <define name="transaction">
      <element name="transaction">
         <a:documentation xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0">(Transaction) Purchases and forms of monetization that appear in, or are indexed by, the gameplay footage</a:documentation>
         <rng:empty xmlns:rng="http://relaxng.org/ns/structure/1.0"/>
      </element>
   </define>
   <define name="metagaming">
      <element name="metagaming">
         <a:documentation xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0">(Metagaming) Acts of play appearing in the gamemplay footage that involve or consider resources that are beyond the scope or control of what players . . . collectively consider to be the right and correct game (Carter et al. 2012)</a:documentation>
         <rng:empty xmlns:rng="http://relaxng.org/ns/structure/1.0"/>
      </element>
   </define>
   <define name="gameplayTrope">
      <element name="gameplayTrope">
         <a:documentation xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0">(Gameplay Trope) A generally recognizable [gameplay] device or convention [appearing in the footage]. [Gameplay] tropes rely on culturally mediated expectations to expedite the development of [mechanics, action, agency, experiences, and] events. When overused or oversimplified, tropes often come at the expense of fair and inclusive representations (Lee et al., VGMS 4.2, 2024)</a:documentation>
         <rng:empty xmlns:rng="http://relaxng.org/ns/structure/1.0"/>
      </element>
   </define>
   <define name="environmentTrope">
      <element name="environmentTrope">
         <a:documentation xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0">(Environment Trope) A generally recognizable [worldbuilding] device or [environment design] convention [appearing in the footage]. [Environment] tropes rely on culturally mediated expectations to expedite the development of [atmospheres and experiences as well as the traversal of biomes, built environments, and locations]. When overused or oversimplified, tropes often come at the expense of fair and inclusive representations (Lee et al., VGMS 4.2, 2024)</a:documentation>
         <rng:empty xmlns:rng="http://relaxng.org/ns/structure/1.0"/>
      </element>
   </define>
   <define name="progressionTrope">
      <element name="progressionTrope">
         <a:documentation xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0">(Progression Trope) A generally recognizable [progression] device or [level design] convention [appearing in the footage]. [Progression] tropes rely on culturally mediated expectations to expedite [advancement, acknowledge attempts to advance, or afford players with a sense of progress, achievement, or productivity]. When overused or oversimplified, tropes often come at the expense of fair and inclusive representations (Lee et al., VGMS 4.2, 2024).</a:documentation>
         <rng:empty xmlns:rng="http://relaxng.org/ns/structure/1.0"/>
      </element>
   </define>
   <define name="narrativeTrope">
      <element name="narrativeTrope">
         <a:documentation xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0">(Narrative Trope) A generally recognizable narrative device or [storytelling] convention [appearing in the footage]. [Narrative] tropes rely on culturally mediated expectations to expedite the development of [stories, plots, beats, arcs, experiences, and] events. When overused or oversimplified, tropes often come at the expense of fair and inclusive representations (Lee et al., VGMS 4.2, 2024)</a:documentation>
         <rng:empty xmlns:rng="http://relaxng.org/ns/structure/1.0"/>
      </element>
   </define>
   <define name="gameStudiesTopic">
      <element name="gameStudiesTopic">
         <a:documentation xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0">(Game Studies Topic) Area of Game Studies research, analysis, and discussion prompted by the gameplay footage</a:documentation>
         <rng:empty xmlns:rng="http://relaxng.org/ns/structure/1.0"/>
      </element>
   </define>
   <define name="mediaStudiesTopic">
      <element name="mediaStudiesTopic">
         <a:documentation xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0">(Media Studies Topic) Area of Media Studies research, analysis, and discussion prompted by the gameplay footage</a:documentation>
         <rng:empty xmlns:rng="http://relaxng.org/ns/structure/1.0"/>
      </element>
   </define>
   <define name="gameplayRecord">
      <element name="gameplayRecord">
         <a:documentation xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0">(Gameplay record) A metadata record describing one gameplay recording.</a:documentation>
         <group>
            <ref name="platformEdition"/>
            <ref name="gameplayFile"/>
            <ref name="gameplaySettings"/>
            <ref name="gameplayFootage"/>
            <ref name="gameplayInstruction"/>
         </group>
         <ref name="att.identifiable.attributes"/>
         <empty/>
      </element>
   </define>
   <define name="platformEdition">
      <element name="platformEdition">
         <a:documentation xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0">(Platform edition) Groups the platform edition metadata fields.</a:documentation>
         <group>
            <ref name="title"/>
            <ref name="release"/>
            <oneOrMore>
               <ref name="platform"/>
            </oneOrMore>
            <zeroOrMore>
               <ref name="engine"/>
            </zeroOrMore>
            <ref name="developer"/>
            <oneOrMore>
               <ref name="developerLocation"/>
            </oneOrMore>
            <oneOrMore>
               <ref name="publisher"/>
            </oneOrMore>
            <optional>
               <ref name="platformEditionNote"/>
            </optional>
         </group>
      </element>
   </define>
   <define name="gameplayFile">
      <element name="gameplayFile">
         <a:documentation xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0">(Gameplay file) Groups the gameplay file metadata fields.</a:documentation>
         <group>
            <ref name="clipTitle"/>
            <ref name="clipLength"/>
            <ref name="dateRecorded"/>
            <oneOrMore>
               <ref name="commentary"/>
            </oneOrMore>
            <oneOrMore>
               <ref name="chat"/>
            </oneOrMore>
            <ref name="gameplayAttribution"/>
            <ref name="metadataAttribution"/>
            <ref name="recordStatus"/>
            <ref name="filename"/>
            <optional>
               <ref name="gameplayFileNote"/>
            </optional>
         </group>
      </element>
   </define>
   <define name="gameplaySettings">
      <element name="gameplaySettings">
         <a:documentation xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0">(Gameplay settings) Groups the gameplay settings metadata fields.</a:documentation>
         <group>
            <oneOrMore>
               <ref name="inputDevice"/>
            </oneOrMore>
            <oneOrMore>
               <ref name="connectivity"/>
            </oneOrMore>
            <ref name="numPlayers"/>
            <oneOrMore>
               <ref name="gameplayMode"/>
            </oneOrMore>
            <oneOrMore>
               <ref name="language"/>
            </oneOrMore>
            <oneOrMore>
               <ref name="accessibility"/>
            </oneOrMore>
            <optional>
               <ref name="mods"/>
            </optional>
            <optional>
               <ref name="gameplaySettingsNote"/>
            </optional>
         </group>
      </element>
   </define>
   <define name="gameplayFootage">
      <element name="gameplayFootage">
         <a:documentation xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0">(Gameplay footage) Groups the gameplay footage metadata fields.</a:documentation>
         <group>
            <oneOrMore>
               <ref name="typeOfPlay"/>
            </oneOrMore>
            <oneOrMore>
               <ref name="gameplayGenre"/>
            </oneOrMore>
            <oneOrMore>
               <ref name="gameplaySubgenre"/>
            </oneOrMore>
            <oneOrMore>
               <ref name="narrativeGenre"/>
            </oneOrMore>
            <oneOrMore>
               <ref name="narrativeSubgenre"/>
            </oneOrMore>
            <oneOrMore>
               <ref name="dimensionPerspective"/>
            </oneOrMore>
            <oneOrMore>
               <ref name="location"/>
            </oneOrMore>
            <oneOrMore>
               <ref name="timePeriod"/>
            </oneOrMore>
            <oneOrMore>
               <ref name="biome"/>
            </oneOrMore>
            <oneOrMore>
               <ref name="builtEnv"/>
            </oneOrMore>
            <oneOrMore>
               <ref name="transport"/>
            </oneOrMore>
            <oneOrMore>
               <ref name="items"/>
            </oneOrMore>
            <oneOrMore>
               <ref name="atmosphere"/>
            </oneOrMore>
            <oneOrMore>
               <ref name="playerCharacter"/>
            </oneOrMore>
            <oneOrMore>
               <ref name="nonPlayerCharacter"/>
            </oneOrMore>
            <oneOrMore>
               <ref name="mechanics"/>
            </oneOrMore>
            <oneOrMore>
               <ref name="timekeeping"/>
            </oneOrMore>
            <oneOrMore>
               <ref name="progression"/>
            </oneOrMore>
            <oneOrMore>
               <ref name="theme"/>
            </oneOrMore>
            <oneOrMore>
               <ref name="assets"/>
            </oneOrMore>
            <oneOrMore>
               <ref name="style"/>
            </oneOrMore>
            <oneOrMore>
               <ref name="interface"/>
            </oneOrMore>
            <oneOrMore>
               <ref name="experience"/>
            </oneOrMore>
            <oneOrMore>
               <ref name="transaction"/>
            </oneOrMore>
            <oneOrMore>
               <ref name="metagaming"/>
            </oneOrMore>
            <zeroOrMore>
               <ref name="gameplayTrope"/>
            </zeroOrMore>
            <zeroOrMore>
               <ref name="environmentTrope"/>
            </zeroOrMore>
            <zeroOrMore>
               <ref name="progressionTrope"/>
            </zeroOrMore>
            <zeroOrMore>
               <ref name="narrativeTrope"/>
            </zeroOrMore>
            <optional>
               <ref name="characterTrope"/>
            </optional>
            <ref name="contentWarning"/>
            <optional>
               <ref name="gameplayFootageNote"/>
            </optional>
         </group>
      </element>
   </define>
   <define name="gameplayInstruction">
      <element name="gameplayInstruction">
         <a:documentation xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0">(Gameplay instruction) Groups the gameplay instruction metadata fields.</a:documentation>
         <group>
            <oneOrMore>
               <ref name="gameStudiesTopic"/>
            </oneOrMore>
            <oneOrMore>
               <ref name="mediaStudiesTopic"/>
            </oneOrMore>
            <optional>
               <ref name="gameplayInstructionNote"/>
            </optional>
         </group>
      </element>
   </define>
   <define name="title">
      <element name="title">
         <a:documentation xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0">(Title) Free-text title.</a:documentation>
         <text/>
      </element>
   </define>
   <define name="developer">
      <element name="developer">
         <a:documentation xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0">(Developer) Free-text developer.</a:documentation>
         <text/>
      </element>
   </define>
   <define name="platformEditionNote">
      <element name="platformEditionNote">
         <a:documentation xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0">(Platform edition note) Free-text platform edition note.</a:documentation>
         <text/>
      </element>
   </define>
   <define name="clipTitle">
      <element name="clipTitle">
         <a:documentation xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0">(Clip title) Free-text clip title.</a:documentation>
         <text/>
      </element>
   </define>
   <define name="clipLength">
      <element name="clipLength">
         <a:documentation xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0">(Clip length) Free-text clip length.</a:documentation>
         <text/>
      </element>
   </define>
   <define name="dateRecorded">
      <element name="dateRecorded">
         <a:documentation xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0">(Date recorded) Free-text date recorded.</a:documentation>
         <text/>
      </element>
   </define>
   <define name="gameplayAttribution">
      <element name="gameplayAttribution">
         <a:documentation xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0">(Gameplay attribution) Free-text gameplay attribution.</a:documentation>
         <text/>
      </element>
   </define>
   <define name="metadataAttribution">
      <element name="metadataAttribution">
         <a:documentation xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0">(Metadata attribution) Free-text metadata attribution.</a:documentation>
         <text/>
      </element>
   </define>
   <define name="filename">
      <element name="filename">
         <a:documentation xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0">(Filename) Free-text filename.</a:documentation>
         <text/>
      </element>
   </define>
   <define name="gameplayFileNote">
      <element name="gameplayFileNote">
         <a:documentation xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0">(Gameplay file note) Free-text gameplay file note.</a:documentation>
         <text/>
      </element>
   </define>
   <define name="language">
      <element name="language">
         <a:documentation xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0">(Language) Free-text language.</a:documentation>
         <text/>
      </element>
   </define>
   <define name="mods">
      <element name="mods">
         <a:documentation xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0">(Mods) Free-text mods.</a:documentation>
         <text/>
      </element>
   </define>
   <define name="gameplaySettingsNote">
      <element name="gameplaySettingsNote">
         <a:documentation xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0">(Gameplay settings note) Free-text gameplay settings note.</a:documentation>
         <text/>
      </element>
   </define>
   <define name="characterTrope">
      <element name="characterTrope">
         <a:documentation xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0">(Character trope) Free-text character trope.</a:documentation>
         <text/>
      </element>
   </define>
   <define name="contentWarning">
      <element name="contentWarning">
         <a:documentation xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0">(Content warning) Free-text content warning.</a:documentation>
         <text/>
      </element>
   </define>
   <define name="gameplayFootageNote">
      <element name="gameplayFootageNote">
         <a:documentation xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0">(Gameplay footage note) Free-text gameplay footage note.</a:documentation>
         <text/>
      </element>
   </define>
   <define name="gameplayInstructionNote">
      <element name="gameplayInstructionNote">
         <a:documentation xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0">(Gameplay instruction note) Free-text gameplay instruction note.</a:documentation>
         <text/>
      </element>
   </define>
   <define name="release">
      <element name="release">
         <a:documentation xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0">(Release) The release includes the year and release type.</a:documentation>
         <empty/>
         <attribute name="year">
            <a:documentation xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0">(The year of release of this game edition) </a:documentation>
            <data type="gYear"/>
         </attribute>
         <attribute name="type">
            <a:documentation xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0">(Type of release) </a:documentation>
            <choice>
               <value>rtAlpha</value>
               <a:documentation xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0">(Alpha) </a:documentation>
               <value>rtBeta</value>
               <a:documentation xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0">(Beta) </a:documentation>
               <value>rtDemo</value>
               <a:documentation xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0">(Demo) </a:documentation>
               <value>rtDownloadable</value>
               <a:documentation xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0">(Downloadable content (DLC)) </a:documentation>
               <value>rtEarlyAccess</value>
               <a:documentation xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0">(Early access) </a:documentation>
               <value>rtEmulation</value>
               <a:documentation xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0">(Emulation) </a:documentation>
               <value>rtExpansion</value>
               <a:documentation xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0">(Expansion) </a:documentation>
               <value>rtFanGame</value>
               <a:documentation xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0">(Fan game) </a:documentation>
               <value>rtInitOrOrigRelease</value>
               <a:documentation xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0">(Initial release / original release) </a:documentation>
               <value>rtPort</value>
               <a:documentation xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0">(Port) </a:documentation>
               <value>rtReboot</value>
               <a:documentation xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0">(Reboot) </a:documentation>
               <value>rtRemake</value>
               <a:documentation xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0">(Remake) </a:documentation>
               <value>rtRemaster</value>
               <a:documentation xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0">(Remaster) </a:documentation>
               <value>rtUnfinished</value>
               <a:documentation xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0">(Unfinished) </a:documentation>
            </choice>
         </attribute>
         <empty/>
      </element>
   </define>
   <define name="att.identifiable.attributes">
      <ref name="att.identifiable.attribute.xmlid"/>
   </define>
   <define name="att.identifiable.attribute.xmlid">
      <attribute name="xml:id">
         <a:documentation xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0">(standard xml:id attribute) </a:documentation>
         <data type="ID"/>
      </attribute>
   </define>
   <start>
      <choice>
         <ref name="gameplayRecord"/>
      </choice>
   </start>
   <sch:ns xmlns="http://www.tei-c.org/ns/1.0"
           xmlns:pr="http://hcmc.uvic.ca/ns/PressRecord"
           xmlns:rng="http://relaxng.org/ns/structure/1.0"
           xmlns:sch="http://purl.oclc.org/dsdl/schematron"
           xmlns:sqf="http://www.schematron-quickfix.com/validator/process"
           xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns:xsl="http://www.w3.org/1999/XSL/Transform"
           prefix="tei"
           uri="http://www.tei-c.org/ns/1.0"/>
   <sch:ns xmlns="http://www.tei-c.org/ns/1.0"
           xmlns:pr="http://hcmc.uvic.ca/ns/PressRecord"
           xmlns:rng="http://relaxng.org/ns/structure/1.0"
           xmlns:sch="http://purl.oclc.org/dsdl/schematron"
           xmlns:sqf="http://www.schematron-quickfix.com/validator/process"
           xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns:xsl="http://www.w3.org/1999/XSL/Transform"
           prefix="xs"
           uri="http://www.w3.org/2001/XMLSchema"/>
   <sch:ns xmlns="http://www.tei-c.org/ns/1.0"
           xmlns:pr="http://hcmc.uvic.ca/ns/PressRecord"
           xmlns:rng="http://relaxng.org/ns/structure/1.0"
           xmlns:sch="http://purl.oclc.org/dsdl/schematron"
           xmlns:sqf="http://www.schematron-quickfix.com/validator/process"
           xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns:xsl="http://www.w3.org/1999/XSL/Transform"
           prefix="rng"
           uri="http://relaxng.org/ns/structure/1.0"/>
   <sch:ns xmlns="http://www.tei-c.org/ns/1.0"
           xmlns:pr="http://hcmc.uvic.ca/ns/PressRecord"
           xmlns:rng="http://relaxng.org/ns/structure/1.0"
           xmlns:sch="http://purl.oclc.org/dsdl/schematron"
           xmlns:sqf="http://www.schematron-quickfix.com/validator/process"
           xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns:xsl="http://www.w3.org/1999/XSL/Transform"
           prefix="rna"
           uri="http://relaxng.org/ns/compatibility/annotations/1.0"/>
   <sch:ns xmlns="http://www.tei-c.org/ns/1.0"
           xmlns:pr="http://hcmc.uvic.ca/ns/PressRecord"
           xmlns:rng="http://relaxng.org/ns/structure/1.0"
           xmlns:sch="http://purl.oclc.org/dsdl/schematron"
           xmlns:sqf="http://www.schematron-quickfix.com/validator/process"
           xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns:xsl="http://www.w3.org/1999/XSL/Transform"
           prefix="sch"
           uri="http://purl.oclc.org/dsdl/schematron"/>
   <sch:ns xmlns="http://www.tei-c.org/ns/1.0"
           xmlns:pr="http://hcmc.uvic.ca/ns/PressRecord"
           xmlns:rng="http://relaxng.org/ns/structure/1.0"
           xmlns:sch="http://purl.oclc.org/dsdl/schematron"
           xmlns:sqf="http://www.schematron-quickfix.com/validator/process"
           xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns:xsl="http://www.w3.org/1999/XSL/Transform"
           prefix="sch1x"
           uri="http://www.ascc.net/xml/schematron"/>
   <sch:ns xmlns="http://www.tei-c.org/ns/1.0"
           xmlns:pr="http://hcmc.uvic.ca/ns/PressRecord"
           xmlns:rng="http://relaxng.org/ns/structure/1.0"
           xmlns:sch="http://purl.oclc.org/dsdl/schematron"
           xmlns:sqf="http://www.schematron-quickfix.com/validator/process"
           xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns:xsl="http://www.w3.org/1999/XSL/Transform"
           prefix="pr"
           uri="http://hcmc.uvic.ca/ns/PressRecord"/>
   <sch:pattern xmlns="http://www.tei-c.org/ns/1.0"
                xmlns:pr="http://hcmc.uvic.ca/ns/PressRecord"
                xmlns:rng="http://relaxng.org/ns/structure/1.0"
                xmlns:sch="http://purl.oclc.org/dsdl/schematron"
                xmlns:sqf="http://www.schematron-quickfix.com/validator/process"
                xmlns:xs="http://www.w3.org/2001/XMLSchema"
                xmlns:xsl="http://www.w3.org/1999/XSL/Transform">
      <sch:let name="spaceRegex" value="'(^\s)|(\s$)'"/>
      <sch:let name="docId" value="root(/)/pr:*/@xml:id"/>
      <sch:let name="docUri" value="(document-uri(/), base-uri(/))[1]"/>
      <sch:let name="docIds" value="//pr:*[@xml:id]/@xml:id"/>
   </sch:pattern>
   <sch:pattern xmlns="http://www.tei-c.org/ns/1.0"
                xmlns:pr="http://hcmc.uvic.ca/ns/PressRecord"
                xmlns:rng="http://relaxng.org/ns/structure/1.0"
                xmlns:sch="http://purl.oclc.org/dsdl/schematron"
                xmlns:sqf="http://www.schematron-quickfix.com/validator/process"
                xmlns:xs="http://www.w3.org/2001/XMLSchema"
                xmlns:xsl="http://www.w3.org/1999/XSL/Transform">
      <sch:rule context="/pr:*">
         <sch:assert test="@xml:id and tokenize($docUri, '[/\\]')[last()] eq (string($docId) || '.xml')"> ERROR: Document
                           xml:id (<sch:value-of select="$docId"/>) does not match the document file
                           name (<sch:value-of select="$docUri"/>). </sch:assert>
      </sch:rule>
   </sch:pattern>
   <sch:pattern xmlns="http://www.tei-c.org/ns/1.0"
                xmlns:pr="http://hcmc.uvic.ca/ns/PressRecord"
                xmlns:rng="http://relaxng.org/ns/structure/1.0"
                xmlns:sch="http://purl.oclc.org/dsdl/schematron"
                xmlns:sqf="http://www.schematron-quickfix.com/validator/process"
                xmlns:xs="http://www.w3.org/2001/XMLSchema"
                xmlns:xsl="http://www.w3.org/1999/XSL/Transform">
      <sch:rule context="/pr:gameplayRecord">
         <sch:assert test="matches(@xml:id, '^game_[0-9]{5}$')">[<sch:value-of select="@xml:id"/>]: PROBLEM: xml:id must use game_ followed by five digits.</sch:assert>
      </sch:rule>
   </sch:pattern>
   <sch:pattern xmlns="http://www.tei-c.org/ns/1.0"
                xmlns:pr="http://hcmc.uvic.ca/ns/PressRecord"
                xmlns:rng="http://relaxng.org/ns/structure/1.0"
                xmlns:sch="http://purl.oclc.org/dsdl/schematron"
                xmlns:sqf="http://www.schematron-quickfix.com/validator/process"
                xmlns:xs="http://www.w3.org/2001/XMLSchema"
                xmlns:xsl="http://www.w3.org/1999/XSL/Transform">
      <sch:rule context="pr:gameplayFile/pr:clipLength">
         <sch:assert test="matches(string(.), '^[0-9]{2}:[0-5][0-9]$')">[<sch:value-of select="$docId"/>]: PROBLEM: clipLength must use MM:SS, with minutes 00–99 and seconds 00–59.</sch:assert>
      </sch:rule>
   </sch:pattern>
   <sch:pattern xmlns="http://www.tei-c.org/ns/1.0"
                xmlns:pr="http://hcmc.uvic.ca/ns/PressRecord"
                xmlns:rng="http://relaxng.org/ns/structure/1.0"
                xmlns:sch="http://purl.oclc.org/dsdl/schematron"
                xmlns:sqf="http://www.schematron-quickfix.com/validator/process"
                xmlns:xs="http://www.w3.org/2001/XMLSchema"
                xmlns:xsl="http://www.w3.org/1999/XSL/Transform">
      <sch:rule context="pr:gameplayFile/pr:dateRecorded">
         <sch:assert test="matches(string(.), '^[0-9]{4}-[0-9]{2}-[0-9]{2}$') and string(.) castable as xs:date">[<sch:value-of select="$docId"/>]: PROBLEM: dateRecorded must be a valid date in YYYY-MM-DD format.</sch:assert>
      </sch:rule>
   </sch:pattern>
</grammar>
